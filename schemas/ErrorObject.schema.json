{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/ErrorObject.schema.json",
  "title": "ErrorObject",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "ArtifactRef.schema.json"
      }
    },
    "details": {
      "type": "object"
    }
  },
  "required": [
    "code",
    "stage",
    "message",
    "retryable",
    "artifact_refs",
    "details"
  ],
  "additionalProperties": false
}
