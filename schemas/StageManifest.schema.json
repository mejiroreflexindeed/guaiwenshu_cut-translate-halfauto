{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/StageManifest.schema.json",
  "title": "StageManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "INPUT",
        "MEDIA_PREP",
        "OCR",
        "ASR",
        "SOURCE",
        "TRANSLATION",
        "SUBTITLE_BUILD",
        "QUALITY_AND_COMMIT"
      ]
    },
    "attempt_id": {
      "type": "string"
    },
    "input_signature": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "ArtifactRef.schema.json"
      }
    },
    "validation_ref": {
      "$ref": "ArtifactRef.schema.json"
    },
    "committed_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "stage",
    "attempt_id",
    "input_signature",
    "outputs",
    "validation_ref",
    "committed_at"
  ],
  "additionalProperties": false
}
