{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/JobInput.schema.json",
  "title": "JobInput",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "local_video",
        "url"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "source_media_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "value",
    "source_media_id"
  ],
  "additionalProperties": false
}
