{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/ExternalFileRef.schema.json",
  "title": "ExternalFileRef",
  "type": "object",
  "properties": {
    "absolute_path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "mtime_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "absolute_path",
    "sha256",
    "bytes",
    "mtime_ns"
  ],
  "additionalProperties": false
}
