{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/ResourceDeclaration.schema.json",
  "title": "ResourceDeclaration",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "ffmpeg",
        "ffprobe",
        "asr_engine",
        "ocr_engine",
        "translation_engine",
        "model",
        "font",
        "editor"
      ]
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_content_sha256": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstream_url": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstream_revision": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "license_status": {
      "type": "string",
      "enum": [
        "recorded",
        "unresolved",
        "not_for_redistribution"
      ]
    },
    "version_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "kind",
    "absolute_path",
    "files",
    "expected_content_sha256",
    "upstream_url",
    "upstream_revision",
    "license_status",
    "version_args",
    "extensions"
  ],
  "additionalProperties": false
}
