{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/TaskRecord.schema.json",
  "title": "TaskRecord",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "INTERRUPTED",
        "CANCELLED"
      ]
    },
    "active_stage": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INPUT",
            "MEDIA_PREP",
            "OCR",
            "ASR",
            "SOURCE",
            "TRANSLATION",
            "SUBTITLE_BUILD",
            "QUALITY_AND_COMMIT"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "StageRecord.schema.json"
      },
      "minItems": 1
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "last_error": {
      "oneOf": [
        {
          "$ref": "ErrorObject.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "machine_revision_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "request_id",
    "status",
    "active_stage",
    "stages",
    "created_at",
    "updated_at",
    "last_error",
    "machine_revision_id",
    "extensions"
  ],
  "additionalProperties": false
}
