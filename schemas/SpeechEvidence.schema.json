{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/SpeechEvidence.schema.json",
  "title": "SpeechEvidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evidence_id": {
      "type": "string"
    },
    "media_id": {
      "type": "string"
    },
    "audio_artifact": {
      "$ref": "ArtifactRef.schema.json"
    },
    "engine_ref": {
      "$ref": "ResourceRef.schema.json"
    },
    "model_ref": {
      "$ref": "ResourceRef.schema.json"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "Parent.schema.json"
      }
    },
    "word_times": {
      "type": "array",
      "items": {
        "$ref": "Word.schema.json"
      }
    },
    "processing_intervals": {
      "type": "array",
      "items": {
        "$ref": "Interval.schema.json"
      }
    },
    "activity_intervals": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "Interval.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "process_completed_only",
        "activity_compared",
        "unknown"
      ]
    },
    "raw_refs": {
      "type": "array",
      "items": {
        "$ref": "ArtifactRef.schema.json"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "media_id",
    "audio_artifact",
    "engine_ref",
    "model_ref",
    "language",
    "parents",
    "word_times",
    "processing_intervals",
    "activity_intervals",
    "coverage_status",
    "raw_refs",
    "extensions"
  ],
  "additionalProperties": false
}
