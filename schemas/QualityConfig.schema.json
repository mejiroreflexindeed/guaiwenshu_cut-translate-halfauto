{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roast.local/v2/QualityConfig.schema.json",
  "title": "QualityConfig",
  "type": "object",
  "properties": {
    "rule_set_version": {
      "type": "integer",
      "minimum": 1
