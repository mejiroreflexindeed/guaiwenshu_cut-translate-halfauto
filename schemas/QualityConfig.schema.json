    "ocr_continuity_gap_ms": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "activity_gap_ms": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "rule_set_version",
    "min_duration_ms",
    "max_duration_ms",
    "max_cps",
    "ocr_probability_min",
    "asr_probability_min",
    "ocr_continuity_gap_ms",
    "activity_gap_ms"
